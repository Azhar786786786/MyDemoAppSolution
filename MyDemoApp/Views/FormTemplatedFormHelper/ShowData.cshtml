}
@model Student
<h1 class="p-2 bg-secondary text-white">Employee Information</h1>
<div class="p-4 bg-body-secondary">
    <div class="m-2">
        Roll: @Model.RollNumber
    </div>
    <div class="m-2">
        Name: @Model.Name
    </div>
    <div class="m-2">
        DOB: @Model.DateOfBirth.ToString("dd/MM/yyyy")
    </div>

    <div class="m-2">
        Gender: @Model.Gender
    </div>
    <div class="m-2">
        Disability: @Model.IsDisable
    </div>
</div>