@{
}
@model IEnumerable<MyDemoApp.Models.Employee>
<h1 class="p-3 mb-2 bg-success text-white">Employee Details</h1>
<table class="table table-striped bg-info-subtle">
    <tr>
        <td>RollNumber</td>
        <td>Employee Name</td>
        <td>Employee Gender</td>
        <td>Date Of Birth</td>
    </tr>
    @foreach (var emp in Model)
    {
        <tr>
            <td>@emp.EmployeeId</td>
            <td>@emp.Name</td>
            <td>@emp.Gender</td>
            <td>@emp.DateOfBirth</td>
        </tr>
    }
</table>