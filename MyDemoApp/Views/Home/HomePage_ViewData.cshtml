﻿@{
int total = Convert.ToInt32(ViewData["price"]) * Convert.ToInt32(ViewData["qty"]);
int Sum = Convert.ToInt32(ViewData["Number1"]) + Convert.ToInt32(ViewData["Number2"]);
}
<h1>Details of Product</h1>
<hr />
<h3>Product Id:@ViewData["id"]</h3>
<h3>Product Name:@ViewData["name"]</h3>
<h3>Product Price:@ViewData["price"]</h3>
<h3>Product Qty:@ViewData["qty"]</h3>
<h3>Total:@total</h3>
<h3>Sum:@Sum</h3>