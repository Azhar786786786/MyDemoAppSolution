﻿@{
ViewData["Title"] = "FormPassDataRequest Page";
}

<h1 class="p-2 bg-secondary text-white">Enter Your Information</h1>
<div class="container-fluid p-3 bg-body-tertiary">
    <form action="FormPassDataRequest/ShowData" method="post">
        <div class="p-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" />
        </div>
        <div class="p-3">
            <label class="form-label">Father's Name</label>
            <input type="text" name="fname" class="form-control" />
        </div>
        <div class="p-3">
            <label class="form-label">Gender</label>
            <select name="gender" class="form-select">
                <option value="Male">Male</option>
                <option value="Female">Female</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="p-3">
            <label class="form-label">Date of Birth</label>
            <input type="date" name="dob" class="form-control" />
        </div>
        <div class="p-3">
            <label class="form-label">Is Any Disablity?</label>
            <input type="radio" name="disability" value="Yes" class="form-check d-inline" />Yes
            <input type="radio" name="disability" value="No" class="form-check d-inline" />No
        </div>
        <div class="p-3 mt-2">
            <input type="submit" value="Register" class="btn btn-success" />
        </div>
    </form>
</div>