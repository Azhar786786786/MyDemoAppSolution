@{
}
@model Student
<h1 class="p-3 bg-secondary text-white">Information Recieved From User</h1>
<div class="container-fluid bg-body-secondary p-4">
    <div class="p-3">
        <strong>Name:</strong>@Model.Name
    </div>
    <div class="p-3">
        <strong>Father's Name:</strong>@Model.FName
    </div>
    <div class="p-3">
        <strong>Gender:</strong>@Model.Gender
    </div>
    <div class="p-3">
        <strong>DOB:</strong>@Model.DateOfBirth
    </div>
</div>