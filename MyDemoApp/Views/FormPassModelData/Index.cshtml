﻿@{
ViewData["Title"] = "FormPassModelData Page";
}
@model Student
<h1 class="p-2 bg-secondary text-white">Student Information Form</h1>
<div class="container">
    <div class="row">
        <div class="col-lg-6">
            <form method="post" asp-action="ShowData" asp-controller="FormPassModelData">
                <div class="mb-2">
                    <label asp-for="Name" class="form-label"></label>
                    <input type="text" asp-for="Name" class="form-control" />
                </div>
                <div class="mb-2">
                    <label asp-for="FName" class="form-label"></label>
                    <input type="text" asp-for="FName" class="form-control" />
                </div>
                <div class="mb-2">
                    <label asp-for="Gender" class="form-label"></label>
                    <select asp-for="Gender" class="form-select">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label asp-for="DateOfBirth" class="form-label"></label>
                    <input type="date" asp-for="DateOfBirth" class="form-control" />
                </div>
                <div class="mb-2">
                    <input type="submit" value="Register" class="btn btn-success" />
                </div>
            </form>
        </div>
    </div>
</div>